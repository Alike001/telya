{
  "name": "telya",
  "version": "0.0.0",
  "private": true,
  "description": "Conversational money movement on Stellar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "env:check": "node scripts/check-environment.mjs",
    "testnet:probe": "tsc --project tsconfig.server.json && node --env-file-if-exists=.env.local dist/scripts/probe-testnet.js",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsc --project tsconfig.server.json && node dist/scripts/migrate.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@privy-io/node": "0.42.0",
    "@privy-io/react-auth": "3.52.1",
    "@stellar/stellar-sdk": "^16.4.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "smart-account-kit": "0.10.0"
  }
}
