  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@privy-io/node": "0.42.0",
    "@stellar/stellar-sdk": "^16.4.1",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "smart-account-kit": "0.10.0"
