  "description": "Conversational money movement on Stellar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.server.json && node dist/scripts/reconcile-migration-ledger-http.js && next build",
